# Production (client-exposed)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-side only (NOT exposed to client bundle)
# IMPORTANT: This key bypasses RLS - only for local import scripts
SUPABASE_SERVICE_ROLE_KEY=

# Test email accounts (comma-separated, only for development)
EXPO_PUBLIC_ALLOWED_TEST_EMAILS=

# Dev/Testing Features (set to false for production)
EXPO_PUBLIC_SHOW_DEV_LOGIN=false
